model Order {
  id          String      @id @default(cuid())
  userId      String
  recipient   String
  phone       String?
  address     String?
  total       Float
  status      OrderStatus @default(PENDING)
  paymentId   String?
  paymentDate DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderCode   String      @unique
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]

  notes       String?     // یادداشت مشتری
  adminNote   String?     // یادداشت ادمین
  
  @@index([userId, status])
  @@index([status, createdAt])
  @@map("orders")
}


model OrderItem {
  id          String  @id @default(cuid())
  quantity    Int
  price       Float   
  originalPrice Float? 
  discount    Float?  
  
  productId   String  
  colorId     String  
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productName String?
  productSlug String?
  productImage String?
  colorName   String?
  colorHex    String?

  @@map("order_items")
}


model GlassOrder {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  customerName      String
  customerPhone     String?
  status            OrderStatus @default(PENDING)
  
  glassType         String   
  thickness         Float    
  quantity          Int      
  dimensions        String   
  description       String? 
  
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  factoryOrderId    String?
  
  paymentStatus     OrderStatus @default(PENDING)
  totalPrice        Float?
  costPrice         Float?
  salePrice         Float?
  profit            Float?

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@map("glass_orders")
}


model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String?
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  targetType String?  // 'post' یا 'product'
  targetId   String?  // ID در Sanity

  @@map("comments")
}


model Notification {
  id          String            @id @default(cuid())
  recipientId String
  type        NotificationType?
  read        Boolean           @default(false)
  createdAt   DateTime          @default(now())
  issuerId    String
  
  // فیلدهای جدید برای ارتباط با Sanity
  targetType  String?           // 'post' یا 'product' یا 'order'
  targetId    String?           // ID در Sanity یا Order ID
  
  issuer      User              @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  recipient   User              @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}



enum NotificationType {
  COMMENT
  POST
  REPLY
  PAID
  DELIVERED
  ORDER
  PRODUCT
}

enum ReportType {
  USER
  REPLY
  COMMENT
  POST
  PRODUCT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SENT_TO_FACTORY
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}




